---
import Layout from '../layouts/Layout.astro';
import Container from '../components/layout/Container.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import Button from '../components/ui/Button.astro';

const crumbs = [{ name: 'Home', href: '/' }, { name: 'About' }];
---

<Layout
  title="About FormFit — Free Private Image Compressor & Resizer | FormFit"
  description="About FormFit: free browser-based image compressor, resizer, and converter. Learn why your photos never leave your device and why FormFit is completely free."
  path="/about/"
>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://formfit-f1l.pages.dev/" },
        { "@type": "ListItem", "position": 2, "name": "About", "item": "https://formfit-f1l.pages.dev/about/" }
      ]
    }
  </script>
  <Container width="narrow">
    <div class="py-16">
      <Breadcrumbs items={crumbs} />
      <h1 class="mt-7 text-[2rem] font-semibold tracking-[-0.374px] sm:text-display-lg">About FormFit</h1>
      <p class="mt-5 text-lead text-ink-muted-80">
        FormFit is a collection of free, focused tools that compress, resize, and convert images
        for online forms — so that "upload failed" becomes "ready to submit".
      </p>

      <div class="mt-12 space-y-12">
        <section>
          <h2 class="text-display-md font-semibold tracking-[-0.374px]">Free image compressor, resizer, and converter</h2>
          <p class="mt-4 text-body text-ink-muted-80">
            Online applications are full of image requirements: under 50 KB, exactly 300 × 300
            pixels, JPG only, signature under 20 KB. FormFit turns each one into a simple tool —
            you enter the requirement, upload an image, and download the result.
          </p>
          <p class="mt-4 text-body text-ink-muted-80">
            Today that means an image compressor that targets exact KB, an image resizer for
            precise pixel dimensions, a signature resizer for online forms, and an image converter
            between JPG, PNG, and WebP. More tools are planned, each solving one real upload problem.
          </p>
        </section>

        <section>
          <h2 class="text-display-md font-semibold tracking-[-0.374px]">Why everything runs in your browser</h2>
          <p class="mt-4 text-body text-ink-muted-80">
            Your photos, scans, and signatures are private. FormFit is a browser-based image
            compressor and resizer — all processing runs entirely on your device: the file is
            read, changed, and downloaded right there. We do not upload, store, or analyse your
            images — there is no server in the path.
          </p>
          <p class="mt-4 text-body text-ink-muted-80">
            There is also nothing to install and nothing to wait for. A tool loads instantly, and
            the result appears as soon as your device finishes the work — no round trip across the
            internet.
          </p>
        </section>

        <section>
          <h2 class="text-display-md font-semibold tracking-[-0.374px]">No accounts. No subscriptions. Completely free.</h2>
          <p class="mt-4 text-body text-ink-muted-80">
            Using FormFit should be as simple as using a ruler. There is no account, no login, and
            no subscription — open the free image compressor, resizer, or converter, prepare your
            image, and leave.
          </p>
        </section>

        <section>
          <h2 class="text-display-md font-semibold tracking-[-0.374px]">Who FormFit is for</h2>
          <p class="mt-4 text-body text-ink-muted-80">
            Job seekers, students, applicants, and anyone facing a stubborn upload box. Whether
            you need to compress a photo to 100 KB, resize an image to 300 × 300 pixels, prepare
            a signature, or convert JPG to PNG, you do not need to know anything about pixels,
            file sizes, or formats to use FormFit.
          </p>
        </section>

        <div>
          <Button href="/compress-image/" size="lg">
            Try the Compressor
          </Button>
        </div>
      </div>
    </div>
  </Container>
</Layout>