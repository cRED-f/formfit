---
import ToolShell, { type ToolRelated } from '../../components/tool/ToolShell.astro';
import UploadPanel from '../../components/tool/UploadPanel.astro';
import CropPanel from '../../components/tool/CropPanel.astro';
import ResultPanel from '../../components/tool/ResultPanel.astro';
import Button from '../../components/ui/Button.astro';
import Input from '../../components/ui/Input.astro';
import Select from '../../components/ui/Select.astro';

const faq = [
  {
    q: 'How do I compress an image to a specific KB?',
    a: 'Upload your image, enter the target file size in KB — for example, 50, 100, or 200 — and click Compress Image. FormFit uses intelligent compression to find the highest quality that still fits under your limit. It works for JPG, PNG, and WebP.',
  },
  {
    q: 'What does "compress to 50 KB" mean?',
    a: 'You tell FormFit the maximum file size your form allows — say 50 KB — and the image compressor produces the highest-quality version that fits under that limit. It works back from 100% quality, so you always get the best result that meets the requirement.',
  },
  {
    q: 'Will compression ruin my image quality?',
    a: 'No. FormFit compresses gradually and stops as soon as the file fits, preserving as much quality as possible. If an image is so large it cannot reach the target without shrinking dimensions, FormFit tells you clearly instead of silently destroying the quality.',
  },
  {
    q: 'Can I compress a photo below 100 KB for an application form?',
    a: 'Yes. Enter 100 in the target field and the photo compressor will find the best quality under 100 KB. This works for any limit — 20 KB for signatures, 50 KB for exam photos, 200 KB for document scans, and more.',
  },
  {
    q: 'Is there a limit to how large a file I can upload?',
    a: 'FormFit processes images up to about 25 MB in your browser. Larger photos still work but may take a little longer on slower devices.',
  },
  {
    q: 'Do you upload my images?',
    a: 'Never. FormFit is a browser-based image compressor — compression happens entirely on your device. Your photo is read, compressed, and downloaded without ever being sent to a server.',
  },
];

const howTo = [
  'Upload the image you need to shrink.',
  'Enter the maximum file size your form allows — FormFit fills in 50 KB for you.',
  'Compress. FormFit finds the best quality that still fits.',
  'Check the result, then download the file that now satisfies the requirement.',
];

const examples = [
  '2.3 MB photo → under 100 KB',
  '850 KB scan → under 50 KB',
  '120 KB signature → under 20 KB',
];

const related: ToolRelated[] = [
  { title: 'Resize Image', href: '/resize-image/', description: 'Change width and height exactly.', icon: 'resize' },
  { title: 'Signature Resizer', href: '/signature-resizer/', description: 'Prepare a signature for online forms.', icon: 'signature' },
  { title: 'Image Converter', href: '/image-converter/', description: 'Convert JPG, PNG, and WebP.', icon: 'convert' },
];
---

<ToolShell
  title="Compress Image to Exact KB Online | Free Photo Compressor"
  description="Compress image to exact KB — target 50 KB, 100 KB, or any file size limit. Free online photo compressor that finds the highest quality under your limit. Runs in your browser."
  path="/compress-image/"
  heading="Compress Image"
  intro="Forms often reject images simply because they are too large. Tell FormFit the exact file size your form allows — 20 KB, 50 KB, 100 KB, or any limit — and the image compressor delivers the highest-quality version that fits under it."
  toolName="Exact File-Size Image Compressor"
  howTo={howTo}
  examples={examples}
  faq={faq}
  related={related}
>
  <div slot="tool">
    <UploadPanel>
      <div slot="controls">
        <CropPanel />

        <div class="grid gap-5 sm:grid-cols-2">
          <Input
            id="compress-target"
            label="Target file size"
            type="number"
            inputmode="numeric"
            min="1"
            max="1000"
            defaultValue="50"
            unit="KB"
          />
          <Select
            id="compress-format"
            label="Output format"
            options={[
              { value: 'jpeg', label: 'JPG' },
              { value: 'webp', label: 'WebP' },
            ]}
          />
        </div>

        <p class="mt-5 rounded-md bg-parchment px-4 py-3 text-caption text-ink-muted-80">
          Image still too big after compressing? We'll suggest safely reducing its dimensions, rather
          than silently ruining the quality.
        </p>

        <div class="mt-6">
          <Button size="lg" icon="compress" data-run="compress">
            Compress Image
          </Button>
        </div>
      </div>
      <ResultPanel slot="result" />
    </UploadPanel>
  </div>
</ToolShell>

<script>
  import { mountCompress } from '../../lib/image/tools';
  const root = document.querySelector<HTMLElement>('[data-formfit-upload]');
  if (root) mountCompress(root);
</script>