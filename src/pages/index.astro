---
import Layout from '../layouts/Layout.astro';
import Container from '../components/layout/Container.astro';
import Icon, { type IconName } from '../components/ui/Icon.astro';
import IconTile from '../components/ui/IconTile.astro';
import HeroUpload from '../components/tool/HeroUpload.astro';
import UploadPanel from '../components/tool/UploadPanel.astro';
import CropPanel from '../components/tool/CropPanel.astro';
import PreviewPanel from '../components/tool/PreviewPanel.astro';
import ResultPanel from '../components/tool/ResultPanel.astro';
import Input from '../components/ui/Input.astro';
import Select from '../components/ui/Select.astro';
import Button from '../components/ui/Button.astro';
import FAQList, { type Faq } from '../components/seo/FAQList.astro';

const tools: { id: string; icon: IconName; title: string; description: string }[] = [
  { id: 'resize', icon: 'resize', title: 'Resize Image', description: 'Set exact pixel dimensions.' },
  { id: 'compress', icon: 'compress', title: 'Compress Image', description: 'Shrink to a target file size.' },
  { id: 'signature', icon: 'signature', title: 'Signature Resizer', description: 'Crop and resize signatures for forms.' },
  { id: 'convert', icon: 'convert', title: 'Image Converter', description: 'Convert between JPG, PNG, and WebP.' },
];

const useCases = [
  'Job applications',
  'University applications',
  'Government forms',
  'Examination registrations',
  'Scholarship applications',
  'Visa & passport photos',
  'Profile pictures',
  'Online portals & document uploads',
];

const faq: Faq[] = [
  {
    q: 'What is FormFit?',
    a: 'FormFit is a free online tool that lets you compress, resize, and convert images directly in your browser. It helps you prepare photos and signatures for online forms without uploading your files to any server.',
  },
  {
    q: 'How can I compress an image online?',
    a: 'Upload your image to the FormFit compressor tool, set your desired file size or quality, and download the compressed image instantly. The entire process happens in your browser — no server upload required.',
  },
  {
    q: 'How can I reduce image size in KB?',
    a: 'Use the FormFit image compressor to reduce your image file size in KB. Enter your target size — such as 50 KB or 100 KB — and FormFit will compress the image to fit within that limit while keeping the best possible quality.',
  },
  {
    q: 'How can I compress an image to 50KB?',
    a: 'Open the FormFit compressor, upload your image, enter 50 in the target size field, and click Compress. FormFit will reduce your image to 50 KB or smaller while maintaining the highest possible quality.',
  },
  {
    q: 'How can I resize an image to exact pixels?',
    a: 'Use the FormFit resizer tool to enter your exact width and height in pixels. You can set any dimension like 300x300, 500x500, or custom sizes to match your form requirements.',
  },
  {
    q: 'How do I resize an image to 300x300 pixels?',
    a: 'Upload your image to the FormFit resizer, enter 300 in both the width and height fields, and click Resize. Your image will be resized to exactly 300x300 pixels.',
  },
  {
    q: 'Can I resize and compress an image at the same time?',
    a: 'Yes, you can use FormFit to resize your image to the required dimensions and then compress it to the target file size. Both tools work together to prepare your image for any online form.',
  },
  {
    q: 'How can I resize a signature online?',
    a: 'Upload your signature image to the FormFit signature resizer, set the required width and height, and download the resized signature. FormFit automatically crops empty space and centres the signature.',
  },
  {
    q: 'How can I compress a signature to 20KB?',
    a: 'Use the FormFit signature compressor to upload your signature, set the maximum file size to 20 KB, and download the compressed result. FormFit ensures your signature fits within the size limit.',
  },
  {
    q: 'Can I resize JPG, PNG, and WebP images?',
    a: 'Yes, FormFit supports JPG, PNG, and WebP images. You can resize and compress all three formats directly in your browser.',
  },
  {
    q: 'How can I convert PNG to JPG?',
    a: 'Upload your PNG image to the FormFit image converter, select JPG as the output format, and download the converted file. The conversion happens instantly in your browser.',
  },
  {
    q: 'Does resizing an image reduce file size?',
    a: 'Yes, resizing an image to smaller pixel dimensions typically reduces its file size. However, if you need to meet an exact KB limit, it is best to use a dedicated image compressor after resizing.',
  },
  {
    q: 'How can I reduce image size without losing too much quality?',
    a: 'Use the FormFit image compressor to reduce file size while maintaining the best possible quality. It uses smart compression to shrink your image without making it look blurry or pixelated.',
  },
  {
    q: 'Can I compress images without uploading them to a server?',
    a: 'Yes, FormFit runs entirely in your browser. Your images are never uploaded to any server, making it a completely private way to compress and resize your photos.',
  },
  {
    q: 'Is FormFit free to use?',
    a: 'Yes, FormFit is completely free. You can compress, resize, and convert as many images as you need without any cost.',
  },
  {
    q: 'Do I need to create an account to use FormFit?',
    a: 'No, FormFit does not require any account or registration. Simply open the tool, upload your image, and download the result.',
  },
  {
    q: 'How can I prepare a photo for an online application form?',
    a: 'Upload your photo to FormFit, resize it to the required dimensions, compress it to the allowed file size, and download the ready-to-upload image — all in a few clicks.',
  },
  {
    q: 'How can I reduce a photo below an upload size limit?',
    a: 'Use the FormFit compressor to set your target file size below the upload limit. Enter the maximum size allowed by your form and FormFit will compress the photo to fit.',
  },
  {
    q: 'What is the difference between image dimensions and image file size?',
    a: 'Image dimensions refer to the width and height of the image in pixels, such as 300x300. Image file size refers to the storage space the image occupies, measured in KB or MB. FormFit lets you control both — resize dimensions and compress file size separately.',
  },
  {
    q: 'What is the best image format for a smaller file size?',
    a: 'JPG and WebP are generally the best formats for smaller file sizes. PNG is ideal when you need transparency. FormFit supports all three and lets you convert between them easily.',
  },
];

const guides = [
  { href: '/compress-to-kb/', title: 'How to compress an image to 50 KB', description: 'Target 20, 50, 100 KB, or any exact file-size limit.' },
  { href: '/resize-to-pixels/', title: 'Resize a photo to exact pixels', description: '100×100, 200×200, 300×300, 500×500 — exactly.' },
  { href: '/form-photos/', title: 'Prepare a photo for an online form', description: 'A step-by-step walkthrough before you hit submit.' },
];

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'FormFit',
  url: 'https://formfit-f1l.pages.dev',
  description:
    'Free online image compressor, resizer, and converter. Compress to exact KB, resize to any pixel dimension, and prepare images for online forms — all private and in your browser.',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Layout
  title="Free Image Compressor & Resizer Online | FormFit"
  description="Compress image to exact KB, resize photo to any dimension, prepare signature for online forms, and convert JPG/PNG/WebP — free, private, and entirely in your browser."
  path="/"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Hero -->
  <section class="bg-canvas">
    <Container>
      <div class="py-20 text-center sm:py-28">
        <h1 class="mx-auto max-w-4xl text-[2.125rem] font-semibold tracking-[-0.374px] sm:text-4xl lg:text-hero lg:tracking-[-0.28px]">
          Make any image upload-ready
        </h1>
        <p class="mx-auto mt-6 max-w-xl text-lead text-ink-muted-80">
          Free image compressor, resizer, and converter — compress to exact KB, resize to any dimension, and prepare photos and signatures for online forms.
        </p>

        <!-- Default hero upload (demo gif) -->
        <div data-hero-upload class="mt-10">
          <HeroUpload />
        </div>

        <!-- Inline tool panels (hidden until a card is clicked) -->
        <div data-hero-tools class="mx-auto mt-10 hidden max-w-2xl text-left">
          <!-- Resize -->
          <div data-panel="resize" class="hidden">
            <UploadPanel>
              <div slot="controls">
                <CropPanel />
                <div class="grid gap-5 sm:grid-cols-2">
                  <Input id="home-resize-width" label="Width" type="number" inputmode="numeric" min="1" placeholder="300" unit="px" />
                  <Input id="home-resize-height" label="Height" type="number" inputmode="numeric" min="1" placeholder="300" unit="px" />
                </div>
                <div class="mt-5 flex flex-wrap items-end gap-x-8 gap-y-5">
                  <label class="inline-flex cursor-pointer select-none items-center gap-2 text-[15px] text-ink">
                    <input id="home-resize-aspect" type="checkbox" checked class="h-4 w-4 accent-primary" />
                    Maintain aspect ratio
                  </label>
                  <div class="w-full sm:w-64">
                    <Select
                      id="home-resize-format"
                      label="Output format"
                      options={[
                        { value: 'jpeg', label: 'JPG' },
                        { value: 'png', label: 'PNG' },
                        { value: 'webp', label: 'WebP' },
                      ]}
                    />
                  </div>
                </div>
                <PreviewPanel />
                <div class="mt-6">
                  <Button size="lg" data-run="home-resize">Resize Image</Button>
                </div>
              </div>
              <ResultPanel slot="result" />
            </UploadPanel>
          </div>

          <!-- Compress -->
          <div data-panel="compress" class="hidden">
            <UploadPanel>
              <div slot="controls">
                <CropPanel />
                <div class="grid gap-5 sm:grid-cols-2">
                  <Input id="home-compress-target" label="Target file size" type="number" inputmode="numeric" min="1" max="1000" defaultValue="50" unit="KB" />
                  <Select
                    id="home-compress-format"
                    label="Output format"
                    options={[
                      { value: 'jpeg', label: 'JPG' },
                      { value: 'webp', label: 'WebP' },
                    ]}
                  />
                </div>
                <p class="mt-5 rounded-md bg-parchment px-4 py-3 text-caption text-ink-muted-80">
                  Image still too big after compressing? We'll suggest safely reducing its dimensions, rather than silently ruining the quality.
                </p>
                <div class="mt-6">
                  <Button size="lg" icon="compress" data-run="home-compress">Compress Image</Button>
                </div>
              </div>
              <ResultPanel slot="result" />
            </UploadPanel>
          </div>

          <!-- Signature -->
          <div data-panel="signature" class="hidden">
            <UploadPanel>
              <div slot="controls">
                <CropPanel />
                <div class="grid gap-5 sm:grid-cols-3">
                  <Input id="home-sig-width" label="Width" type="number" inputmode="numeric" min="1" defaultValue="300" unit="px" />
                  <Input id="home-sig-height" label="Height" type="number" inputmode="numeric" min="1" defaultValue="80" unit="px" />
                  <Input id="home-sig-kb" label="Maximum size" type="number" inputmode="numeric" min="1" defaultValue="20" unit="KB" />
                </div>
                <div class="mt-5 w-full sm:w-72">
                  <Select
                    id="home-sig-background"
                    label="Background"
                    options={[
                      { value: 'original', label: 'Original' },
                      { value: 'white', label: 'White' },
                      { value: 'transparent', label: 'Transparent' },
                    ]}
                  />
                </div>
                <p class="mt-5 rounded-md bg-parchment px-4 py-3 text-caption text-ink-muted-80">
                  We automatically crop empty space around the signature, keep its proportions, and center it in the frame.
                </p>
                <PreviewPanel />
                <div class="mt-6">
                  <Button size="lg" icon="signature" data-run="home-signature">Prepare Signature</Button>
                </div>
              </div>
              <ResultPanel slot="result" />
            </UploadPanel>
          </div>

          <!-- Convert -->
          <div data-panel="convert" class="hidden">
            <UploadPanel>
              <div slot="controls">
                <CropPanel />
                <div class="grid gap-5 sm:grid-cols-2">
                  <Select
                    id="home-conv-format"
                    label="Convert to"
                    options={[
                      { value: 'jpeg', label: 'JPG' },
                      { value: 'png', label: 'PNG' },
                      { value: 'webp', label: 'WebP' },
                    ]}
                  />
                  <Select
                    id="home-conv-quality"
                    label="Quality"
                    options={[
                      { value: 'high', label: 'High — larger file' },
                      { value: 'balanced', label: 'Balanced' },
                      { value: 'small', label: 'Small — smaller file' },
                    ]}
                  />
                </div>
                <div class="mt-6">
                  <Button size="lg" icon="convert" data-run="home-convert">Convert Image</Button>
                </div>
              </div>
              <ResultPanel slot="result" />
            </UploadPanel>
          </div>

          <button type="button" data-back class="mt-6 text-caption font-medium text-ink-muted-48 transition hover:text-ink">
            ← Back to all tools
          </button>
        </div>

        <!-- Trust indicators strip -->
        <div class="mx-auto mt-10 flex max-w-lg flex-wrap items-center justify-center gap-x-6 gap-y-3 text-fine-print text-ink-muted-48">
          <span class="inline-flex items-center gap-1.5">
            <Icon name="lock" size={13} class="text-ink-muted-48" />
            100% private
          </span>
          <span class="inline-flex items-center gap-1.5">
            <Icon name="user" size={13} class="text-ink-muted-48" />
            No login required
          </span>
          <span class="inline-flex items-center gap-1.5">
            <Icon name="bolt" size={13} class="text-ink-muted-48" />
            Works offline
          </span>
          <span class="inline-flex items-center gap-1.5">
            <Icon name="resize" size={13} class="text-ink-muted-48" />
            Free forever
          </span>
        </div>
      </div>
    </Container>
  </section>

  <!-- Popular tools -->
  <section id="tools" class="bg-parchment">
    <Container>
      <div class="py-20">
        <h2 class="text-center text-display-md font-semibold tracking-[-0.374px]">Popular tools</h2>
        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {tools.map((tool) => (
            <button
              type="button"
              data-tool={tool.id}
              class="group rounded-lg border border-hairline bg-canvas p-7 text-left transition-colors hover:bg-pearl data-[active]:border-primary data-[active]:bg-pearl"
            >
              <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-parchment text-primary">
                <Icon name={tool.icon} size={22} />
              </div>
              <h3 class="mt-5 text-body font-semibold">{tool.title}</h3>
              <p class="mt-1.5 text-caption text-ink-muted-48">{tool.description}</p>
              <span class="mt-4 inline-flex items-center gap-1 text-caption font-semibold text-primary">
                Use now
                <Icon name="arrowRight" size={14} class="transition-transform group-hover:translate-x-0.5" />
              </span>
            </button>
          ))}
        </div>
      </div>
    </Container>
  </section>

  <!-- Why FormFit -->
  <section class="bg-canvas">
    <Container width="standard">
      <div class="py-20">
        <h2 class="text-center text-display-md font-semibold tracking-[-0.374px]">Why FormFit</h2>
        <p class="mx-auto mt-4 max-w-xl text-center text-body text-ink-muted-80">
          The simplest way to compress, resize, and convert images for any online form — no software to install, no account to create, and nothing uploaded.
        </p>
        <div class="mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
          <div class="text-center">
            <div class="mx-auto inline-flex">
              <IconTile name="lock" size="md" />
            </div>
            <h3 class="mt-6 text-tagline font-semibold">Private by design</h3>
            <p class="mx-auto mt-2 max-w-xs text-body text-ink-muted-80">
              Your images never leave your device. Zero server uploads, zero tracking, zero risk.
            </p>
          </div>
          <div class="text-center">
            <div class="mx-auto inline-flex">
              <IconTile name="bolt" size="md" />
            </div>
            <h3 class="mt-6 text-tagline font-semibold">Instantly fast</h3>
            <p class="mx-auto mt-2 max-w-xs text-body text-ink-muted-80">
              No upload wait time. Results appear the moment your image is ready — even on slow connections.
            </p>
          </div>
          <div class="text-center">
            <div class="mx-auto inline-flex">
              <IconTile name="user" size="md" />
            </div>
            <h3 class="mt-6 text-tagline font-semibold">No login, ever</h3>
            <p class="mx-auto mt-2 max-w-xs text-body text-ink-muted-80">
              No account, no signup, no email. Just open a tool and start working.
            </p>
          </div>
          <div class="text-center">
            <div class="mx-auto inline-flex">
              <IconTile name="fileImage" size="md" />
            </div>
            <h3 class="mt-6 text-tagline font-semibold">Free forever</h3>
            <p class="mx-auto mt-2 max-w-xs text-body text-ink-muted-80">
              All tools are completely free. No limits, no watermarks, no "upgrade" prompts.
            </p>
          </div>
          <div class="text-center">
            <div class="mx-auto inline-flex">
              <IconTile name="resize" size="md" />
            </div>
            <h3 class="mt-6 text-tagline font-semibold">Works offline</h3>
            <p class="mx-auto mt-2 max-w-xs text-body text-ink-muted-80">
              Once loaded, FormFit works without an internet connection. Perfect for travel or spotty Wi-Fi.
            </p>
          </div>
          <div class="text-center">
            <div class="mx-auto inline-flex">
              <IconTile name="shield" size="md" />
            </div>
            <h3 class="mt-6 text-tagline font-semibold">No ads, no tracking</h3>
            <p class="mx-auto mt-2 max-w-xs text-body text-ink-muted-80">
              No analytics scripts, no ad networks, no cookies. Your browsing stays yours.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- How it works (dark tile) -->
  <section class="bg-tile-1 text-white">
    <Container width="standard">
      <div class="py-20">
        <h2 class="text-center text-display-md font-semibold tracking-[-0.374px]">How it works</h2>
        <div class="mt-12 grid gap-8 sm:grid-cols-3">
          {[
            ['Upload', 'Choose an image and enter your form\'s requirement.'],
            ['FormFit prepares it', 'Crop, resize, convert, and compress — all in-browser.'],
            ['Download', 'Save the result, matching your form\'s rules.'],
          ].map(([title, body], index) => (
            <div class="text-center">
              <span class="mx-auto flex h-11 w-11 items-center justify-center rounded-full border border-white/15 bg-white/5 text-[17px] font-semibold text-white shadow-[inset_0_1px_0_rgba(255,255,255,0.15)] backdrop-blur-[14px]">
                {index + 1}
              </span>
              <h3 class="mt-6 text-tagline font-semibold">{title}</h3>
              <p class="mx-auto mt-2 max-w-xs text-body text-body-muted">{body}</p>
            </div>
          ))}
        </div>
        <p class="mt-12 flex items-center justify-center gap-2 text-caption text-body-muted">
          <Icon name="shield" size={16} class="text-primary-on-dark" />
          No uploads. Your files stay on your device — always.
        </p>
      </div>
    </Container>
  </section>

  <!-- Use cases -->
  <section class="bg-parchment">
    <Container width="standard">
      <div class="py-20 text-center">
        <h2 class="text-display-md font-semibold tracking-[-0.374px]">Built for real uploads</h2>
        <p class="mx-auto mt-4 max-w-xl text-body text-ink-muted-80">
          When a form rejects your image — too large, wrong dimensions, wrong format — compress, resize, and convert it with FormFit in seconds.
        </p>
        <ul class="mx-auto mt-10 flex max-w-3xl flex-wrap justify-center gap-2.5">
          {useCases.map((item) => (
            <li class="rounded-full border border-hairline bg-canvas px-4 py-2 text-caption text-ink-muted-80">
              {item}
            </li>
          ))}
        </ul>
      </div>
    </Container>
  </section>

  <!-- FormFit vs Others -->
  <section class="bg-canvas">
    <Container width="standard">
      <div class="py-20">
        <h2 class="text-center text-display-md font-semibold tracking-[-0.374px]">FormFit vs. the alternatives</h2>
        <p class="mx-auto mt-4 max-w-xl text-center text-body text-ink-muted-80">
          Why thousands of people choose FormFit over photo editors, online uploaders, and desktop apps.
        </p>
        <div class="mx-auto mt-12 max-w-3xl overflow-hidden rounded-xl border border-hairline">
          <table class="w-full text-left">
            <thead>
              <tr class="border-b border-hairline bg-parchment">
                <th class="px-5 py-4 text-[13px] font-semibold uppercase tracking-wide text-ink-muted-48"></th>
                <th class="px-5 py-4 text-[13px] font-semibold uppercase tracking-wide text-primary">FormFit</th>
                <th class="px-5 py-4 text-[13px] font-semibold uppercase tracking-wide text-ink-muted-48">Photoshop / GIMP</th>
                <th class="px-5 py-4 text-[13px] font-semibold uppercase tracking-wide text-ink-muted-48">Online uploaders</th>
              </tr>
            </thead>
            <tbody class="text-body">
              <tr class="border-b border-hairline">
                <td class="px-5 py-4 font-medium text-ink">Price</td>
                <td class="px-5 py-4 font-semibold text-primary">Free</td>
                <td class="px-5 py-4 text-ink-muted-48">$20+/month</td>
                <td class="px-5 py-4 text-ink-muted-48">Free with limits</td>
              </tr>
              <tr class="border-b border-hairline">
                <td class="px-5 py-4 font-medium text-ink">Account required</td>
                <td class="px-5 py-4 font-semibold text-primary">No</td>
                <td class="px-5 py-4 text-ink-muted-48">Yes</td>
                <td class="px-5 py-4 text-ink-muted-48">Usually yes</td>
              </tr>
              <tr class="border-b border-hairline">
                <td class="px-5 py-4 font-medium text-ink">Images uploaded to server</td>
                <td class="px-5 py-4 font-semibold text-primary">Never</td>
                <td class="px-5 py-4 text-ink-muted-48">No</td>
                <td class="px-5 py-4 text-ink">Always</td>
              </tr>
              <tr class="border-b border-hairline">
                <td class="px-5 py-4 font-medium text-ink">Learning curve</td>
                <td class="px-5 py-4 font-semibold text-primary">None</td>
                <td class="px-5 py-4 text-ink-muted-48">Steep</td>
                <td class="px-5 py-4 text-ink-muted-48">Low</td>
              </tr>
              <tr class="border-b border-hairline">
                <td class="px-5 py-4 font-medium text-ink">Works offline</td>
                <td class="px-5 py-4 font-semibold text-primary">Yes</td>
                <td class="px-5 py-4 text-ink-muted-48">Yes</td>
                <td class="px-5 py-4 text-ink-muted-48">No</td>
              </tr>
              <tr class="border-b border-hairline">
                <td class="px-5 py-4 font-medium text-ink">Ads / watermarks</td>
                <td class="px-5 py-4 font-semibold text-primary">None</td>
                <td class="px-5 py-4 text-ink-muted-48">None</td>
                <td class="px-5 py-4 text-ink">Common</td>
              </tr>
              <tr>
                <td class="px-5 py-4 font-medium text-ink">Time to result</td>
                <td class="px-5 py-4 font-semibold text-primary">Seconds</td>
                <td class="px-5 py-4 text-ink-muted-48">Minutes</td>
                <td class="px-5 py-4 text-ink-muted-48">Minutes</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </Container>
  </section>

  <!-- CTA -->
  <section class="bg-tile-1 text-white">
    <Container width="standard">
      <div class="py-20 text-center">
        <h2 class="text-display-md font-semibold tracking-[-0.374px]">Ready to get your image accepted?</h2>
        <p class="mx-auto mt-4 max-w-lg text-body text-body-muted">
          No signup. No upload. No waiting. Pick a tool below and fix your image in seconds.
        </p>
        <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
          <a href="/resize-image/" class="inline-flex items-center gap-2 rounded-full bg-primary px-7 py-3.5 text-[15px] font-semibold text-white shadow-[inset_0_1px_0_rgba(255,255,255,0.18),0_2px_8px_rgba(0,102,204,0.3)] transition-all hover:bg-[#005bb5] hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.18),0_4px_16px_rgba(0,102,204,0.35)]">
            <Icon name="resize" size={16} />
            Resize Image
          </a>
          <a href="/compress-image/" class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-7 py-3.5 text-[15px] font-semibold text-white backdrop-blur-sm transition-all hover:bg-white/10 hover:border-white/30">
            <Icon name="compress" size={16} />
            Compress Image
          </a>
          <a href="/signature-resizer/" class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-7 py-3.5 text-[15px] font-semibold text-white backdrop-blur-sm transition-all hover:bg-white/10 hover:border-white/30">
            <Icon name="signature" size={16} />
            Prepare Signature
          </a>
          <a href="/image-converter/" class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-7 py-3.5 text-[15px] font-semibold text-white backdrop-blur-sm transition-all hover:bg-white/10 hover:border-white/30">
            <Icon name="convert" size={16} />
            Convert Image
          </a>
        </div>
      </div>
    </Container>
  </section>

  <!-- FAQ -->
  <section class="bg-canvas">
    <Container width="standard">
      <div class="py-20 text-center">
        <h2 class="text-display-md font-semibold tracking-[-0.374px]">Frequently asked questions</h2>
        <div class="mt-10">
          <FAQList items={faq} />
        </div>
      </div>
    </Container>
  </section>

  <!-- Guides -->
  <section class="bg-parchment">
    <Container width="standard">
      <div class="py-20">
        <h2 class="text-center text-display-md font-semibold tracking-[-0.374px]">Guides</h2>
        <div class="mt-12 grid gap-6 md:grid-cols-3">
          {guides.map((guide) => (
            <a
              href={guide.href}
              class="group rounded-xl border border-hairline bg-canvas p-7 transition-colors hover:-translate-y-0.5 hover:border-[#d2d2d7] hover:bg-pearl"
            >
              <IconTile name="fileImage" size="sm" />
              <h3 class="mt-5 text-body font-semibold">{guide.title}</h3>
              <p class="mt-1.5 text-caption text-ink-muted-48">{guide.description}</p>
              <span class="mt-4 inline-flex items-center gap-1 text-caption font-semibold text-primary">
                Read
                <Icon name="arrowRight" size={14} class="transition-transform group-hover:translate-x-0.5" />
              </span>
            </a>
          ))}
        </div>
      </div>
    </Container>
  </section>

  <script>
    const heroUpload = document.querySelector<HTMLElement>('[data-hero-upload]');
    const heroTools = document.querySelector<HTMLElement>('[data-hero-tools]');
    const backBtn = heroTools?.querySelector<HTMLButtonElement>('[data-back]');

    // Reveal one inline tool panel and hide the rest. Reused by the tool cards
    // and by the hero upload's "Resize it → / Compress it →" buttons.
    function openTool(id: string) {
      const target = heroTools?.querySelector<HTMLElement>(`[data-panel="${id}"]`);
      heroUpload?.classList.add('hidden');
      heroTools?.classList.remove('hidden');
      heroTools?.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => p.classList.add('hidden'));
      target?.classList.remove('hidden');
      heroTools?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    document.querySelectorAll<HTMLButtonElement>('[data-tool]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.tool!;

        // Toggle active card
        document.querySelectorAll('[data-tool]').forEach((b) => b.removeAttribute('data-active'));
        btn.setAttribute('data-active', '');

        openTool(id);
      });
    });

    // The hero's "Resize it → / Compress it →" buttons carry the already-picked
    // image forward, so no page navigation and no second file picker.
    document.querySelector<HTMLElement>('[data-hero-upload]')?.addEventListener('formfit:open-tool', ((e) => {
      const { tool, file } = (e as CustomEvent).detail as { tool: string; file: File | null };
      if (!tool) return;

      openTool(tool);
      if (!file) return;

      // Hand the file to the inline panel's own upload input, which renders the
      // preview and re-dispatches `formfit:file-ready` to the tool mount.
      const input = heroTools?.querySelector<HTMLInputElement>(`[data-panel="${tool}"] [data-file-input]`);
      if (!input) return;
      const dt = new DataTransfer();
      dt.items.add(file);
      input.files = dt.files;
      input.dispatchEvent(new Event('change', { bubbles: true }));
    }) as EventListener);

    backBtn?.addEventListener('click', () => {
      // Show hero upload, hide tool panels
      heroUpload?.classList.remove('hidden');
      heroTools?.classList.add('hidden');
      document.querySelectorAll('[data-tool]').forEach((b) => b.removeAttribute('data-active'));
    });
  </script>

  <script>
    import { mountResize, mountCompress, mountSignature, mountConvert } from '../lib/image/tools';

    const mounts = [
      ['resize', mountResize],
      ['compress', mountCompress],
      ['signature', mountSignature],
      ['convert', mountConvert],
    ] as const;

    for (const [id, mount] of mounts) {
      const root = document.querySelector<HTMLElement>(`[data-panel="${id}"] [data-formfit-upload]`);
      if (root) mount(root, 'home-');
    }
  </script>
</Layout>