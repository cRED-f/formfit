---
import ToolShell, { type ToolRelated } from '../../components/tool/ToolShell.astro';
import UploadPanel from '../../components/tool/UploadPanel.astro';
import CropPanel from '../../components/tool/CropPanel.astro';
import ResultPanel from '../../components/tool/ResultPanel.astro';
import Button from '../../components/ui/Button.astro';
import Select from '../../components/ui/Select.astro';

const faq = [
  {
    q: 'How do I convert JPG to PNG online?',
    a: 'Upload your JPG image, select PNG as the target format in the image converter, and click Convert. FormFit converts JPG to PNG instantly in your browser. You can also convert PNG to JPG, WebP to JPG, or any other combination.',
  },
  {
    q: 'Which format should I choose for a form?',
    a: 'If the form asks for a specific ending — .jpg, .png, or .webp — choose that one. Otherwise JPG is the safest for photos and PNG is best when your image needs a transparent background.',
  },
  {
    q: 'Will converting PNG to JPG lose the transparency?',
    a: 'Yes. JPG does not support transparency, so the image converter fills transparent areas with white when converting PNG to JPG. Use PNG or WebP when transparency matters.',
  },
  {
    q: 'Is WebP accepted by online forms?',
    a: 'Not always. Some older portals only accept JPG or PNG. WebP is a great choice when the form accepts it, because it combines small file size with excellent quality. FormFit lets you convert WebP to JPG or PNG quickly.',
  },
  {
    q: 'Can I convert an image and compress it at the same time?',
    a: 'Yes. The image converter offers quality presets — High, Balanced, and Small — so converting to JPG or WebP also reduces file size. For precise file-size targeting, use the Compress Image tool after converting.',
  },
  {
    q: 'Does the image converter upload my image?',
    a: 'No. Conversion happens entirely in your browser. Your image never leaves your device, making FormFit a private and secure image converter.',
  },
];

const howTo = [
  'Upload the image you need to convert.',
  'Choose the target format: JPG, PNG, or WebP.',
  'Pick a quality setting — higher quality means a larger file.',
  'Convert, preview the result, then download.',
];

const examples = [
  'PNG screenshot → compact JPG for a photo upload',
  'WebP → JPG for a form that only accepts JPG',
  'JPG → PNG when you need to paste a picture with a clear edge',
];

const related: ToolRelated[] = [
  { title: 'Resize Image', href: '/resize-image/', description: 'Change width and height exactly.', icon: 'resize' },
  { title: 'Compress Image', href: '/compress-image/', description: 'Reduce an image to a target file size.', icon: 'compress' },
  { title: 'Signature Resizer', href: '/signature-resizer/', description: 'Prepare a signature for online forms.', icon: 'signature' },
];
---

<ToolShell
  title="Image Converter Online — JPG, PNG, WebP | FormFit"
  description="Convert image between JPG, PNG, and WebP online. Free image converter with quality presets — convert JPG to PNG, PNG to WebP, and more. Runs in your browser."
  path="/image-converter/"
  heading="Image Converter"
  intro="Forms usually insist on a specific format. Upload any JPG, PNG, or WebP and convert it to the format your application asks for — JPG, PNG, or WebP. The image converter runs entirely in your browser, quickly and privately."
  toolName="Online Image Converter"
  howTo={howTo}
  examples={examples}
  faq={faq}
  related={related}
>
  <div slot="tool">
    <UploadPanel>
      <div slot="controls">
        <CropPanel />

        <div class="grid gap-5 sm:grid-cols-2">
          <Select
            id="conv-format"
            label="Convert to"
            options={[
              { value: 'jpeg', label: 'JPG' },
              { value: 'png', label: 'PNG' },
              { value: 'webp', label: 'WebP' },
            ]}
          />
          <Select
            id="conv-quality"
            label="Quality"
            options={[
              { value: 'high', label: 'High — larger file' },
              { value: 'balanced', label: 'Balanced' },
              { value: 'small', label: 'Small — smaller file' },
            ]}
          />
        </div>

        <div class="mt-6">
          <Button size="lg" icon="convert" data-run="convert">
            Convert Image
          </Button>
        </div>
      </div>
      <ResultPanel slot="result" />
    </UploadPanel>
  </div>
</ToolShell>

<script>
  import { mountConvert } from '../../lib/image/tools';
  const root = document.querySelector<HTMLElement>('[data-formfit-upload]');
  if (root) mountConvert(root);
</script>