---
import Layout from '../layouts/Layout.astro';
import Container from '../components/layout/Container.astro';
import Icon from '../components/ui/Icon.astro';
import Button from '../components/ui/Button.astro';
---

<Layout
  title="Page Not Found — FormFit"
  description="The page you're looking for doesn't exist. Head back to FormFit's free image compressor, resizer, and converter tools."
  path="/404"
  noindex
>
  <section class="bg-canvas">
    <Container width="narrow">
      <div class="flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
        <span class="flex h-16 w-16 items-center justify-center rounded-2xl bg-parchment text-primary">
          <Icon name="fileImage" size={28} />
        </span>
        <h1 class="mt-8 text-[2rem] font-semibold tracking-[-0.374px] sm:text-display-lg">
          Page not found
        </h1>
        <p class="mt-4 max-w-md text-body text-ink-muted-80">
          The page you're looking for doesn't exist or may have been moved. Head back to our free
          image compressor, resizer, and converter tools.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <Button href="/" size="lg">Go to Homepage</Button>
          <Button href="/compress-image/" size="lg" variant="secondary">Try the Compressor</Button>
        </div>
        <div class="mt-10 flex flex-wrap items-center justify-center gap-4 text-caption text-ink-muted-48">
          <a href="/resize-image/" class="transition-colors hover:text-primary">Resize Image</a>
          <span class="text-hairline">|</span>
          <a href="/compress-image/" class="transition-colors hover:text-primary">Compress Image</a>
          <span class="text-hairline">|</span>
          <a href="/signature-resizer/" class="transition-colors hover:text-primary">Signature Resizer</a>
          <span class="text-hairline">|</span>
          <a href="/image-converter/" class="transition-colors hover:text-primary">Image Converter</a>
        </div>
      </div>
    </Container>
  </section>
</Layout>
