---
import ToolShell, { type ToolRelated } from '../../components/tool/ToolShell.astro';
import UploadPanel from '../../components/tool/UploadPanel.astro';
import CropPanel from '../../components/tool/CropPanel.astro';
import PreviewPanel from '../../components/tool/PreviewPanel.astro';
import ResultPanel from '../../components/tool/ResultPanel.astro';
import Button from '../../components/ui/Button.astro';
import Input from '../../components/ui/Input.astro';
import Select from '../../components/ui/Select.astro';

const faq = [
  {
    q: 'How do I resize a signature to 20 KB for an online form?',
    a: 'Upload your signature photo, set the width and height (commonly 300×80 pixels), enter 20 in the Maximum size field, and click Prepare Signature. The signature resizer automatically crops empty space and compresses to fit under 20 KB.',
  },
  {
    q: 'Do signatures need a transparent background?',
    a: 'Usually not. Most online forms just need a clean signature on white. FormFit can keep the original background, replace it with plain white, or make it transparent for documents where the signature sits on top of other content.',
  },
  {
    q: 'My signature is a photo of paper — can I use it?',
    a: 'Yes. Take a clear photo of the signature, upload it, and the signature compressor crops the surrounding paper, centers the ink, and compresses it to the exact file size and dimensions your form requires.',
  },
  {
    q: 'What size should a signature be for a form?',
    a: 'Many forms ask for something close to 300×80 pixels under 20 KB. Others want 200×60 or 350×100. FormFit lets you enter the exact width, height, and maximum file size your specific form requires.',
  },
  {
    q: 'Can I compress a signature to exact KB?',
    a: 'Yes. Enter the target file size in the Maximum size field — 10 KB, 20 KB, 30 KB, 50 KB, or any limit. The signature compressor finds the best quality that fits under it while maintaining crisp ink edges.',
  },
  {
    q: 'Is my signature private?',
    a: 'Yes. FormFit is a browser-based signature resizer — signatures are processed entirely on your device and never uploaded to any server.',
  },
];

const howTo = [
  'Upload a photo or file of your signature.',
  'Enter the width, height, and maximum size your form requires.',
  'Choose the background: keep it, make it white, or make it transparent.',
  'FormFit crops, centers, resizes, and compresses — download the result.',
];

const examples = [
  'Signature photo → 300 × 80 px, under 20 KB',
  'Whitespace around the signature removed automatically',
  'Transparent-background signature for contracts',
];

const related: ToolRelated[] = [
  { title: 'Resize Image', href: '/resize-image/', description: 'Change width and height exactly.', icon: 'resize' },
  { title: 'Compress Image', href: '/compress-image/', description: 'Reduce an image to a target file size.', icon: 'compress' },
  { title: 'Image Converter', href: '/image-converter/', description: 'Convert JPG, PNG, and WebP.', icon: 'convert' },
];
---

<ToolShell
  title="Signature Resizer Online — Crop & Compress | FormFit"
  description="Resize signature for online forms — crop, compress to exact KB, and set exact dimensions. Free online signature resizer with background removal. Runs in your browser."
  path="/signature-resizer/"
  heading="Signature Resizer"
  intro="Application forms are picky about signatures — usually a specific width, height, and a tiny file size like 20 KB. Upload yours and FormFit's signature resizer automatically crops empty space, centers the signature, and compresses it to fit the exact requirement."
  toolName="Online Signature Resizer"
  howTo={howTo}
  examples={examples}
  faq={faq}
  related={related}
>
  <div slot="tool">
    <UploadPanel>
      <div slot="controls">
        <CropPanel />

        <div class="grid gap-5 sm:grid-cols-3">
          <Input id="sig-width" label="Width" type="number" inputmode="numeric" min="1" defaultValue="300" unit="px" />
          <Input id="sig-height" label="Height" type="number" inputmode="numeric" min="1" defaultValue="80" unit="px" />
          <Input id="sig-kb" label="Maximum size" type="number" inputmode="numeric" min="1" defaultValue="20" unit="KB" />
        </div>

        <div class="mt-5 w-full sm:w-72">
          <Select
            id="sig-background"
            label="Background"
            options={[
              { value: 'original', label: 'Original' },
              { value: 'white', label: 'White' },
              { value: 'transparent', label: 'Transparent' },
            ]}
          />
        </div>

        <p class="mt-5 rounded-md bg-parchment px-4 py-3 text-caption text-ink-muted-80">
          We automatically crop empty space around the signature, keep its proportions, and center it
          in the frame. Use the crop handles above to trim before auto-cropping.
        </p>

        <PreviewPanel />

        <div class="mt-6">
          <Button size="lg" icon="signature" data-run="signature">
            Prepare Signature
          </Button>
        </div>
      </div>
      <ResultPanel slot="result" />
    </UploadPanel>
  </div>
</ToolShell>

<script>
  import { mountSignature } from '../../lib/image/tools';
  const root = document.querySelector<HTMLElement>('[data-formfit-upload]');
  if (root) mountSignature(root);
</script>