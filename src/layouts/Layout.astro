---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SEO, { type Props as SEOProps } from '../components/seo/SEO.astro';

type Props = Omit<SEOProps, 'title' | 'description'> & {
  title: string;
  description: string;
  lang?: string;
};

const { title, description, lang = 'en' } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <meta name="generator" content={Astro.generator} />

    <SEO
      title={title}
      description={description}
      path={Astro.props.path}
      type={Astro.props.type}
      image={Astro.props.image}
      noindex={Astro.props.noindex}
    >
      <slot name="head" />
    </SEO>
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-primary focus:px-5 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />
  </body>
</html>