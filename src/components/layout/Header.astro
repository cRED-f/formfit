---
const current = Astro.url.pathname;

const links = [
  { href: '/resize-image/', label: 'Resize' },
  { href: '/compress-image/', label: 'Compress' },
  { href: '/signature-resizer/', label: 'Signature' },
  { href: '/image-converter/', label: 'Convert' },
  { href: '/about/', label: 'About' },
];

/** Marks the current section active when the pathname starts with (or equals) the link href. */
const isActive = (href: string) =>
  href === '/' ? current === '/' : current.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-hairline bg-white/70 text-ink backdrop-blur-xl">
  <div class="relative mx-auto flex h-11 w-full max-w-[1440px] items-center justify-between px-6 sm:px-8">
    <!-- Wordmark (centered on mobile, left on desktop) -->
    <a
      href="/"
      class="absolute left-1/2 -translate-x-1/2 flex items-center gap-2 text-nav font-semibold transition hover:opacity-70 nav:static nav:translate-x-0"
    >
      <img src="/icon.png" alt="" width="20" height="20" class="h-5 w-5 rounded-sm" aria-hidden="true" />
      <span>FormFit</span>
    </a>

    <!-- Desktop nav (hidden on mobile) -->
    <nav aria-label="Main" class="hidden nav:block">
      <ul class="flex items-center gap-7">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class:list={[
                'text-nav transition hover:text-ink',
                isActive(link.href) ? 'font-semibold text-ink' : 'text-ink-muted-48',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Mobile hamburger -->
    <button
      type="button"
      id="formfit-nav-toggle"
      class="nav:hidden inline-flex h-9 w-9 items-center justify-center rounded-sm text-ink"
      aria-expanded="false"
      aria-controls="formfit-nav-menu"
      aria-label="Menu"
    >
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
        <path d="M2 4.5h14M2 9h14M2 13.5h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <!-- Mobile menu -->
  <div id="formfit-nav-menu" hidden class="nav:hidden border-t border-hairline bg-white/80 backdrop-blur-xl px-6 py-4">
    <nav aria-label="Main (mobile)">
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href} class="block py-3 text-body text-ink-muted-48 transition hover:text-ink">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('#formfit-nav-toggle');
  const menu = document.querySelector<HTMLElement>('#formfit-nav-menu');

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const willOpen = menu.hidden;
      menu.hidden = !willOpen;
      toggle.setAttribute('aria-expanded', String(willOpen));
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.hidden = true;
        toggle.setAttribute('aria-expanded', 'false');
      });
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        menu.hidden = true;
        toggle.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>