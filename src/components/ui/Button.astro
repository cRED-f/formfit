---
import type { HTMLAttributes } from 'astro/types';
import Icon, { type IconName } from './Icon.astro';

export type ButtonVariant = 'primary' | 'secondary' | 'dark' | 'ghost';
export type ButtonSize = 'sm' | 'md' | 'lg';

interface Props extends HTMLAttributes<'a' | 'button'> {
  variant?: ButtonVariant;
  size?: ButtonSize;
  /** Render as a link when provided. */
  href?: string;
  icon?: IconName;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  icon,
  class: className,
  ...rest
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-full font-medium transition active:scale-[0.97]';

const variantClasses = {
  primary:
    'bg-black/[0.78] text-white border border-white/[0.08] shadow-[inset_0_1px_0_rgba(255,255,255,0.18),0_2px_6px_rgba(0,0,0,0.2)] backdrop-blur-xl hover:bg-black/[0.85]',
  secondary:
    'bg-black/[0.05] text-ink border border-black/[0.08] shadow-[inset_0_1px_0_rgba(255,255,255,0.7),0_1px_2px_rgba(0,0,0,0.05)] hover:bg-black/[0.08]',
  dark:
    'bg-black/[0.72] text-white border border-white/[0.06] shadow-[inset_0_1px_0_rgba(255,255,255,0.15),0_2px_6px_rgba(0,0,0,0.18)] backdrop-blur-xl hover:bg-black/[0.82]',
  ghost:
    'bg-black/[0.03] text-ink border border-black/[0.06] shadow-[inset_0_1px_0_rgba(255,255,255,0.8),0_1px_2px_rgba(0,0,0,0.03)] hover:bg-black/[0.06]',
} as const;

const sizeClasses = {
  sm: 'px-4 py-[7px] text-[13px] leading-none',
  md: 'px-[22px] py-[11px] text-[17px] leading-none',
  lg: 'px-[28px] py-[14px] text-[18px] font-light leading-none',
} as const;

const classes = [base, variantClasses[variant], sizeClasses[size], className]
  .filter(Boolean)
  .join(' ');
---

{
  href ? (
    <a href={href} class={classes} {...rest}>
      <slot />
      {icon && <Icon name={icon} size={18} />}
    </a>
  ) : (
    <button type="button" class={classes} {...rest}>
      <slot />
      {icon && <Icon name={icon} size={18} />}
    </button>
  )
}