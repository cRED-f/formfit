---
import Layout from '../../layouts/Layout.astro';
import Container from '../layout/Container.astro';
import Breadcrumbs, { type Crumb } from '../seo/Breadcrumbs.astro';
import FAQList, { type Faq } from '../seo/FAQList.astro';
import Icon, { type IconName } from '../ui/Icon.astro';
import IconTile from '../ui/IconTile.astro';

export interface ToolRelated {
  title: string;
  href: string;
  description: string;
  icon?: IconName;
}

interface Props {
  title: string;
  description: string;
  path: string;
  /** H1 shown at the top of the page. */
  heading: string;
  /** Short intro paragraph under the H1. */
  intro: string;
  /** Label above the tool panel, e.g. "Image Resizer". */
  toolName: string;
  howTo: string[];
  examples: string[];
  faq: Faq[];
  related: ToolRelated[];
}

const { title, description, path, heading, intro, toolName, howTo, examples, faq, related } =
  Astro.props;

const breadcrumbs: Crumb[] = [{ name: 'Home', href: '/' }, { name: heading }];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((crumb, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: crumb.name,
    ...(crumb.href ? { item: new URL(crumb.href, Astro.site ?? 'https://formfit-f1l.pages.dev').toString() } : {}),
  })),
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Layout title={title} description={description} path={path}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Tool header + interface (high on the page) -->
  <section class="bg-canvas">
    <Container width="standard">
      <div class="pt-6">
        <Breadcrumbs items={breadcrumbs} />
      </div>

      <h1 class="mt-7 text-[2rem] font-semibold tracking-[-0.374px] sm:text-display-lg">
        {heading}
      </h1>
      <p class="mt-5 max-w-2xl text-lead text-ink-muted-80">{intro}</p>

      <div class="mt-9">
        <p class="mb-3 text-caption-strong uppercase tracking-wide text-ink-muted-48">{toolName}</p>
        <slot name="tool" />
      </div>
    </Container>
  </section>

  <!-- How to use + examples -->
  <section class="mt-6 bg-parchment">
    <Container width="standard">
      <div class="grid gap-12 py-16 md:grid-cols-2">
        <div>
          <p class="text-caption-strong text-primary">How to use</p>
          <h2 class="mt-1 text-display-md font-semibold tracking-[-0.374px]">Three simple steps</h2>
          <ol class="mt-7 space-y-5">
            {howTo.map((step, index) => (
              <li class="flex gap-4">
                <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-primary text-[13px] font-semibold text-white">
                  {index + 1}
                </span>
                <p class="text-body text-ink-muted-80">{step}</p>
              </li>
            ))}
          </ol>
        </div>
        <div>
          <p class="text-caption-strong text-primary">Examples</p>
          <h2 class="mt-1 text-display-md font-semibold tracking-[-0.374px]">Real-world results</h2>
          <ul class="mt-7 space-y-3">
            {examples.map((example) => (
              <li class="flex items-center gap-3 text-body text-ink-muted-80">
                <Icon name="check" size={18} class="shrink-0 text-primary" />
                {example}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </Container>
  </section>

  <!-- Additional SEO content (optional, passed by the page) -->
  <slot name="content" />

  <!-- FAQ -->
  <section class="bg-canvas">
    <Container width="standard">
      <div class="py-16 text-center">
        <h2 class="text-display-md font-semibold tracking-[-0.374px]">
          Frequently asked questions
        </h2>
        <div class="mt-9">
          <FAQList items={faq} />
        </div>
      </div>
    </Container>
  </section>

  <!-- Related tools -->
  <section class="bg-canvas pb-20">
    <Container width="standard">
      <p class="text-caption-strong text-primary">Keep going</p>
      <h2 class="mt-1 text-display-md font-semibold tracking-[-0.374px]">Related tools</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((tool) => (
          <a
            href={tool.href}
            class="group rounded-xl border border-hairline bg-canvas p-6 transition-colors hover:-translate-y-0.5 hover:border-[#d2d2d7] hover:bg-pearl"
          >
            <IconTile name={tool.icon ?? 'resize'} size="sm" />
            <h3 class="mt-4 text-body font-semibold">{tool.title}</h3>
            <p class="mt-1 text-caption text-ink-muted-48">{tool.description}</p>
            <span class="mt-3 inline-flex items-center gap-1 text-caption font-semibold text-primary">
              Open
              <Icon name="arrowRight" size={14} class="transition-transform group-hover:translate-x-0.5" />
            </span>
          </a>
        ))}
      </div>
    </Container>
  </section>
</Layout>